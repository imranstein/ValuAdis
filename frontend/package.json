{
  "name": "valuadis-frontend",
  "version": "1.0.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "eslint app --ext .js",
    "lint:fix": "eslint . --ext .vue,.js,.ts --fix",
    "type-check": "cd app && npx vue-tsc --noEmit",
    "test:unit": "npm run lint && if [ -f tsconfig.json ]; then npm run type-check; else echo \"Skipping type-check: tsconfig.json not found\"; fi",
    "test:e2e": "playwright test",
    "test:e2e:auth": "PW_SKIP_WEBSERVER=1 npx playwright test tests/e2e/pages/auth.spec.ts --reporter=list",
    "test:e2e:auth:offline": "E2E_SKIP_FRONTEND_CHECK=1 E2E_SKIP_BACKEND_CHECK=1 PW_SKIP_WEBSERVER=1 npx playwright test tests/e2e/pages/auth.spec.ts --reporter=list",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:3000"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^10.8.0"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "nuxt": "^3.21.1"
  },
  "overrides": {
    "serialize-javascript": "^6.0.1"
  }
}
