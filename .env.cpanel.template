# Environment Variables Template for Production
# Copy these to cPanel App Environment Variables sections

## BACKEND (Python App) - Set in "Setup Python App"

### Required Variables
DATABASE_URL=postgresql://valuadis_user:YOUR_DB_PASSWORD@localhost:5432/valuadis_db
SECRET_KEY=change-this-to-a-32-character-random-string-for-security
ENVIRONMENT=production
DEBUG=false

### URLs
FRONTEND_URL=https://valuadis.vulcanig.net
API_BASE_URL=https://valuadis.vulcanig.net/api

### File Storage
UPLOAD_DIR=/home/YOUR_CPANEL_USERNAME/public_html/valuadis/uploads
MAX_UPLOAD_SIZE=10485760

### Database (Individual Components)
POSTGRES_DB=valuadis_db
POSTGRES_USER=valuadis_user
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

### Optional: Email Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@valuadis.vulcanig.net

### Optional: Error Tracking
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

### Optional: Payment Integration (MPesa)
# MPESA_CONSUMER_KEY=your-consumer-key
# MPESA_CONSUMER_SECRET=your-consumer-secret
# MPESA_SHORTCODE=your-shortcode
# MPESA_PASSKEY=your-passkey
# MPESA_ENVIRONMENT=sandbox

### Optional: Redis (if available)
# REDIS_URL=redis://localhost:6379/0

### Optional: Security
# ALLOWED_HOSTS=valuadis.vulcanig.net,www.valuadis.vulcanig.net
# CORS_ORIGINS=https://valuadis.vulcanig.net

---

## FRONTEND (Node.js App) - Set in "Setup Node.js App"

### Required Variables
NUXT_PUBLIC_API_BASE=https://valuadis.vulcanig.net/api
ENVIRONMENT=production

### Optional
# NUXT_PUBLIC_SENTRY_DSN=
# NUXT_PUBLIC_GA_ID=
