# cPanel production environment template.
# Replace every REPLACE_WITH_* value in the cPanel app environment UI.
# Do not paste localhost, wildcard CORS origins, or development secrets.

## BACKEND (Python App)

DATABASE_URL=postgresql://REPLACE_WITH_DB_USER:REPLACE_WITH_DB_PASSWORD@REPLACE_WITH_DB_HOST:5432/REPLACE_WITH_DB_NAME
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@REPLACE_WITH_REDIS_HOST:6379/0
SECRET_KEY=REPLACE_WITH_MIN_32_CHARACTER_RANDOM_SECRET
ENVIRONMENT=production
DEBUG=false
ALLOWED_HOSTS=https://REPLACE_WITH_FRONTEND_DOMAIN

UPLOAD_DIR=/home/REPLACE_WITH_CPANEL_USERNAME/public_html/valuadis/uploads
MAX_UPLOAD_SIZE=10485760

# Optional email configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@REPLACE_WITH_FRONTEND_DOMAIN

# Optional error tracking
SENTRY_DSN=

# Optional payment integration
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=production

## FRONTEND (Node.js App)

NUXT_PUBLIC_API_BASE_URL=https://REPLACE_WITH_FRONTEND_DOMAIN
NUXT_PUBLIC_MAP_DEFAULT_LAT=9.0320
NUXT_PUBLIC_MAP_DEFAULT_LNG=38.7578
NUXT_PUBLIC_DEFAULT_LANGUAGE=en
ENVIRONMENT=production
NUXT_PUBLIC_SENTRY_DSN=
