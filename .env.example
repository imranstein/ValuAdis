# Development-only example values.
# Do not use this file for production. Use .env.production and validate it with:
#   bash scripts/validate-production-env.sh .env.production

# Database Configuration
DB_PASSWORD=changeme
DATABASE_URL=postgresql://valuadis_user:changeme@localhost:5432/valuadis

# Redis Configuration
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379/0

# Application Configuration
SECRET_KEY=dev-secret-key-change-before-shared-environments
ENVIRONMENT=development
ALLOWED_HOSTS=http://localhost:3020,http://127.0.0.1:3020

# Optional M-Pesa Configuration
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Optional Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Frontend Configuration
NUXT_PUBLIC_API_BASE_URL=http://localhost:8020

# File Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760

# Optional Sentry
SENTRY_DSN=
